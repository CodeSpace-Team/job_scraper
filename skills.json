  "version": 1,
  "updated": "2026-08-12",
  "description": "The single official skills list for the job scraper. Every part of the system reads this file: the scraper's keyword matcher, the AI enrichment normaliser, the Google Sheets writer, the published jobs.json and the board's skill picker. There must never be a second skills list anywhere in the codebase.",
  "matching_rules": {
    "case_sensitive_acronyms": "An alias written in all capitals with 5 or fewer letters (JS, TS, SQL, AWS, REST) is matched case-sensitively, so the English words 'rest' and 'it' do not produce false hits.",
    "boundaries": "Aliases are matched on non-identifier boundaries rather than plain word boundaries, so 'C#', '.NET', 'CI/CD' and 'Node.js' match correctly and 'Java' never matches inside 'JavaScript'.",
    "requires_context": "A skill flagged requires_context only counts when a technical context word (developer, engineer, experience, stack, programming, ...) appears nearby. Used for short, ambiguous names such as Swift.",
    "name_matches": "A skill with name_matches false is only found through its aliases, never its own name. Used for Go, which is far too common as an English word."
  },
